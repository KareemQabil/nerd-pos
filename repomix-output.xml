│   ├── product.entity.ts        ← Prisma models
│   └── category.entity.ts
├── dto/
│   ├── create-product.dto.ts    ← Input validation
│   └── update-product.dto.ts
├── events/
│   ├── product-created.event.ts ← Domain events
│   └── product-updated.event.ts
└── handlers/
    └── product-created.handler.ts ← Event handlers
```

