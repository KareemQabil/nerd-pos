/**
 * Permissions Decorator
 *
 * Use @Permissions() to tag endpoints with required permission codes.
 * Works with PermissionsGuard to check DB for user permissions.
 *
 * @example
 * @Permissions('orders.refund')
 * @Post(':id/refund')
