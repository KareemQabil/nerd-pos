  nameEn        String    @map("name_en") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  email         String?   @db.VarChar(255)
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  loyaltyTier   String    @default("BRONZE") @map("loyalty_tier") @db.VarChar(20)
  totalSpent    Decimal   @default(0) @map("total_spent") @db.Decimal(12, 3)
  visitsCount   Int       @default(0) @map("visits_count")
  lastVisit     DateTime? @map("last_visit")
  isActive      Boolean   @default(true) @map("is_active")
  customFields  Json?     @map("custom_fields")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([phone])
  @@index([email])
  @@index([loyaltyTier])
  @@map("customers")
}

// ============================================================================
// MODULE 11: SETTINGS
// ============================================================================

model StoreSettings {
  id            String   @id @default(uuid())
  nameAr        String   @map("name_ar") @db.VarChar(255)
  nameEn        String   @map("name_en") @db.VarChar(255)
  taxNumber     String   @map("tax_number") @db.VarChar(50)
  taxRate       Decimal  @map("tax_rate") @db.Decimal(5, 4)
  serviceCharge Decimal  @default(0) @map("service_charge") @db.Decimal(5, 4)
  currency      String   @default("SAR") @db.VarChar(3)
  timezone      String   @default("Asia/Riyadh") @db.VarChar(50)
  locale        String   @default("ar-SA") @db.VarChar(10)
  address       String?  @db.Text
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  logo          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id        String    @id @default(uuid())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  pin       String?   @db.VarChar(10)
  nameAr    String    @map("name_ar") @db.VarChar(255)
  nameEn    String    @map("name_en") @db.VarChar(255)
  email     String?   @unique @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  roleId    String?   @map("role_id")
  role      String    @db.VarChar(20)
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  userRole Role?               @relation(fields: [roleId], references: [id])
  authLogs AuthenticationLog[]

  @@index([username])
  @@index([role])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  description String?  @db.Text
  level       Int      @default(5)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  section     String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthenticationLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  method        String   @db.VarChar(20)
