  failureReason String?  @map("failure_reason") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(50)
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("authentication_logs")
}

// ============================================================================
// MODULE 06: KITCHEN
// ============================================================================

model KitchenStation {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  nameAr       String   @map("name_ar") @db.VarChar(100)
  color        String   @default("#3B82F6") @db.VarChar(7)
  displayOrder Int      @default(0) @map("display_order")
  categoryIds  String[] @map("category_ids")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets KitchenTicket[]

  @@index([displayOrder])
  @@map("kitchen_stations")
}

model KitchenTicket {
  id           String    @id @default(uuid())
  ticketNumber String    @unique @map("ticket_number") @db.VarChar(30)
