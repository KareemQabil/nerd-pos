}

function createMockProduct(overrides: Partial<any> = {}) {
  return {
    id: 'prod-1',
    sku: 'SKU-001',
    nameAr: 'منتج تجريبي',
    nameEn: 'Test Product',
    price: 35.0,
    cost: 12.0,
    categoryId: 'cat-1',
