  @IsNumber()
  amount: number;

  @IsOptional()
  @IsNumber()
  receivedAmount?: number;

  @IsOptional()
  @IsString()
  cardLast4?: string;

  @IsOptional()
  @IsString()
  transactionId?: string;
}

export class SplitPaymentDto {
  @IsUUID()
