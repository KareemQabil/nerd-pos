  @IsNumber()
  @IsPositive()
  @Max(999999)
  amount: number;

  @IsOptional()
  @IsNumber()
  @IsPositive()
  receivedAmount?: number; // For cash

  @IsOptional()
  @IsString()
  cardLast4?: string;

  @IsOptional()
  @IsString()
  cardType?: string;

  @IsOptional()
  @IsString()
  transactionId?: string;

  @IsOptional()
  @IsNumber()
  tipAmount?: number;

  @IsString()
  createdBy: string;
}

// ==================== SPLIT PAYMENT ====================

