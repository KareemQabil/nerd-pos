    orderId,
    priority: order.deliveryTargetTime
  });
} else {
  // Assign driver
  await deliveryService.assignDriver({
    orderId,
    driverId: driver.id
  });

  // Emit event
  await eventBus.publish('DriverAssigned', {
    orderId,
    driverId: driver.id
  });
}
```

