{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/verification-engine"],
  "testRegex": "verification-engine/verification-engine\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(uuid)/)"],
  "moduleNameMapper": {
    "^@test/(.*)$": "<rootDir>/test/$1",
    "^uuid$": "<rootDir>/node_modules/uuid/dist/index.js"
  },
  "setupFilesAfterEnv": ["<rootDir>/test/verification-engine/setup.ts"],
  "testEnvironment": "node",
  "maxWorkers": 1
}
