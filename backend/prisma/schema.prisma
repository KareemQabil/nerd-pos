// Complete schema for NerdPOS - 19 modules

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ============================================================================
// MODULE 01: PRODUCTS
// =============================================================================

model Category {
  id        String   @id @default(uuid())
  parentId  String?  @map("parent_id")
  nameAr    String   @map("name_ar") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id                      String         @id @default(uuid())
  sku                     String         @unique @db.VarChar(50)
  barcode                 String?        @db.VarChar(50)
  nameAr                  String         @map("name_ar") @db.VarChar(255)
  nameEn                  String         @map("name_en") @db.VarChar(255)
  descriptionAr           String?        @map("description_ar") @db.Text
  descriptionEn           String?        @map("description_en") @db.Text
  categoryId              String         @map("category_id")
  price                   Decimal        @db.Decimal(12, 3)
  cost                    Decimal        @default(0) @db.Decimal(12, 3)
  taxCategory             String         @default("STANDARD") @map("tax_category") @db.VarChar(20)
  unitOfMeasure           String         @default("PIECE") @map("unit_of_measure") @db.VarChar(20)
  trackInventory          Boolean        @default(true) @map("track_inventory")
  allowNegativeStock      Boolean        @default(false) @map("allow_negative_stock")
  hasModifiers            Boolean        @default(false) @map("has_modifiers")
  replenishmentMethod     String         @default("BUY") @map("replenishment_method") @db.VarChar(20)
  kitchenStationId        String?        @map("kitchen_station_id")
  incomeAccountId         String?        @map("income_account_id")
  expenseAccountId        String?        @map("expense_account_id")
  preparationTimeMinutes  Int?           @map("preparation_time_minutes")
  imageUrl                String?        @map("image_url") @db.VarChar(500)
  colorCode               String?        @map("color_code") @db.VarChar(7)
  isActive                Boolean        @default(true) @map("is_active")
  customFields            Json?          @map("custom_fields")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  category          Category                @relation(fields: [categoryId], references: [id])
  modifierGroups    ProductModifierGroup[]
  inventoryItems    InventoryItem[]
  recipe            Recipe?
  recipeIngredients RecipeIngredient[]

  @@index([categoryId])
  @@index([barcode])
  @@index([isActive])
  @@map("products")
}

model ModifierGroup {
  id            String   @id @default(uuid())
  nameAr        String   @map("name_ar") @db.VarChar(255)
  nameEn         String   @map("name_en") @db.VarChar(255)
  selectionType String   @map("selection_type") @db.VarChar(20)
  isRequired    Boolean  @default(false) @map("is_required")
  minSelections Int      @default(0) @map("min_selections")
  maxSelections Int?     @map("max_selections")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id        String  @id @default(uuid())
  groupId   String  @map("group_id")
  nameAr    String  @map("name_ar") @db.VarChar(255)
  nameEn    String  @map("name_en") @db.VarChar(255)
  price     Decimal @default(0) @db.Decimal(12, 3)
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  group ModifierGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId       String @map("product_id")
  modifierGroupId String @map("modifier_group_id")

  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ============================================================================
// MODULE 02: INVENTORY
// ============================================================================

model Warehouse {
  id        String  @id @default(uuid())
  code      String  @unique @db.VarChar(20)
  nameAr    String  @map("name_ar") @db.VarChar(255)
  nameEn    String  @map("name_en") @db.VarChar(255)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  inventoryItems InventoryItem[]

  @@map("warehouses")
}

model InventoryItem {
  id                String  @id @default(uuid())
  productId         String  @map("product_id")
  warehouseId       String  @map("warehouse_id")
  quantityOnHand    Decimal @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  quantityReserved  Decimal @default(0) @map("quantity_reserved") @db.Decimal(12, 3)
  minimumLevel      Decimal @default(0) @map("minimum_level") @db.Decimal(12, 3)
  maximumLevel      Decimal? @map("maximum_level") @db.Decimal(12, 3)
  reorderPoint      Decimal @default(0) @map("reorder_point") @db.Decimal(12, 3)
  averageCost       Decimal @default(0) @map("average_cost") @db.Decimal(12, 3)

  product   Product            @relation(fields: [productId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  batches   InventoryBatch[]

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model InventoryBatch {
  id                String   @id @default(uuid())
  inventoryItemId   String   @map("inventory_item_id")
  batchNumber       String?  @map("batch_number") @db.VarChar(50)
  receivedDate      DateTime @map("received_date")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantityReceived  Decimal  @map("quantity_received") @db.Decimal(12, 3)
  quantityRemaining Decimal  @map("quantity_remaining") @db.Decimal(12, 3)
  costPerUnit       Decimal  @map("cost_per_unit") @db.Decimal(12, 3)
  isVirtualNegative Boolean  @default(false) @map("is_virtual_negative")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([receivedDate])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model Recipe {
  id           String  @id @default(uuid())
  productId    String  @unique @map("product_id")
  yieldQuantity Decimal @default(1) @map("yield_quantity") @db.Decimal(12, 3)
  yieldUnit    String  @default("PIECE") @map("yield_unit") @db.VarChar(20)
  isActive     Boolean @default(true) @map("is_active")

  product     Product            @relation(fields: [productId], references: [id])
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id                  String  @id @default(uuid())
  recipeId            String  @map("recipe_id")
  ingredientProductId String  @map("ingredient_product_id")
  quantityRequired    Decimal @map("quantity_required") @db.Decimal(12, 3)
  unit                String  @db.VarChar(20)
  isPrepared          Boolean @default(false) @map("is_prepared")

  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  ingredient Product @relation(fields: [ingredientProductId], references: [id])

  @@index([recipeId])
  @@index([ingredientProductId])
  @@map("recipe_ingredients")
}

// ============================================================================
// MODULE 03: SALES
// ============================================================================

model SalesOrder {
  id                  String   @id @default(uuid())
  orderNumber         String   @unique @map("order_number") @db.VarChar(30)
  orderType           String   @map("order_type") @db.VarChar(30)
  orderDate           DateTime @default(now()) @map("order_date")
  businessDate        DateTime @map("business_date") @db.Date
  itemSubtotal        Decimal  @default(0) @map("item_subtotal") @db.Decimal(12, 3)
  serviceChargeRate   Decimal  @default(0) @map("service_charge_rate") @db.Decimal(5, 4)
  serviceChargeAmount Decimal  @default(0) @map("service_charge_amount") @db.Decimal(12, 3)
  deliveryCharge      Decimal  @default(0) @map("delivery_charge") @db.Decimal(12, 3)
  subtotalBeforeTax   Decimal  @default(0) @map("subtotal_before_tax") @db.Decimal(12, 3)
  taxRate             Decimal  @map("tax_rate") @db.Decimal(5, 4)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 3)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 3)
  grandTotal          Decimal  @default(0) @map("grand_total") @db.Decimal(12, 3)
  tipAmount           Decimal  @default(0) @map("tip_amount") @db.Decimal(12, 3)
  totalWithTip        Decimal  @default(0) @map("total_with_tip") @db.Decimal(12, 3)
  status              String   @default("DRAFT") @db.VarChar(20)
  paymentStatus       String   @default("PENDING") @map("payment_status") @db.VarChar(20)
  notes               String?  @db.Text
  zatcaUuid           String?  @unique @map("zatca_uuid") @db.VarChar(50)
  zatcaHash           String?  @map("zatca_hash") @db.VarChar(100)
  zatcaPreviousHash   String?  @map("zatca_previous_hash") @db.VarChar(100)
  qrCode              String?  @map("qr_code") @db.Text
  etaUuid             String?  @unique @map("eta_uuid") @db.VarChar(50)
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([orderNumber])
  @@index([orderType])
  @@index([status])
  @@index([businessDate])
  @@index([orderDate])
  @@map("sales_orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String   @map("product_id")
  productNameAr   String?  @map("product_name_ar") @db.VarChar(255)
  productNameEn   String?  @map("product_name_en") @db.VarChar(255)
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 3)
  modifiersAmount Decimal  @default(0) @map("modifiers_amount") @db.Decimal(12, 3)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 3)
  costPerUnit     Decimal  @default(0) @map("cost_per_unit") @db.Decimal(12, 3)
  totalCost       Decimal  @default(0) @map("total_cost") @db.Decimal(12, 3)
  notes           String?  @db.Text
  status          String   @default("NEW") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  order SalesOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@map("order_items")
}

// ============================================================================
// MODULE 04: PAYMENTS
// ============================================================================

model PaymentMethodConfig {
  id                   String  @id @default(uuid())
  code                 String  @unique @db.VarChar(30)
  nameAr               String  @map("name_ar") @db.VarChar(100)
  nameEn               String  @map("name_en") @db.VarChar(100)
  type                 String  @db.VarChar(20)
  requiresTerminal     Boolean @default(false) @map("requires_terminal")
  requiresReference    Boolean @default(false) @map("requires_reference")
  isActive             Boolean @default(true) @map("is_active")
  sortOrder            Int     @default(0) @map("sort_order")
  receivableAccountId  String? @map("receivable_account_id")
  clearingAccountId    String? @map("clearing_account_id")
  feeAccountId         String? @map("fee_account_id")

  @@index([code])
  @@index([isActive])
  @@map("payment_method_configs")
}

model Payment {
  id                  String   @id @default(uuid())
  orderId             String   @map("order_id")
  orderItemId         String?  @map("order_item_id")
  paymentMethod       String   @map("payment_method") @db.VarChar(30)
  amount              Decimal  @db.Decimal(12, 3)
  amountReceived      Decimal? @map("amount_received") @db.Decimal(12, 3)
  changeGiven         Decimal? @map("change_given") @db.Decimal(12, 3)
  foreignCurrencyCode String?  @map("foreign_currency_code") @db.VarChar(3)
  foreignAmount       Decimal? @map("foreign_amount") @db.Decimal(12, 3)
  exchangeRate        Decimal? @map("exchange_rate") @db.Decimal(12, 6)
  referenceNumber     String?  @map("reference_number") @db.VarChar(100)
  terminalId          String?  @map("terminal_id") @db.VarChar(50)
  approvalCode        String?  @map("approval_code") @db.VarChar(50)
  status              String   @default("PENDING") @db.VarChar(20)
  paymentDate         DateTime @default(now()) @map("payment_date")
  sessionId           String   @map("session_id")
  processedBy         String   @map("processed_by")
  metadata            Json?

  @@index([orderId])
  @@index([paymentMethod])
  @@index([status])
  @@index([sessionId])
  @@index([paymentDate])
  @@map("payments")
}

// ============================================================================
// MODULE 05: SESSIONS
// ============================================================================

model RegisterSession {
  id                    String   @id @default(uuid())
  terminalId            String   @map("terminal_id") @db.VarChar(50)
  userId                String   @map("user_id")
  businessDate          DateTime @map("business_date") @db.Date
  openingBalance        Decimal  @map("opening_balance") @db.Decimal(12, 3)
  expectedCash          Decimal  @default(0) @map("expected_cash") @db.Decimal(12, 3)
  actualClosingBalance  Decimal? @map("actual_closing_balance") @db.Decimal(12, 3)
  discrepancy           Decimal? @db.Decimal(12, 3)
  openedAt              DateTime @default(now()) @map("opened_at")
  closedAt              DateTime? @map("closed_at")
  status                String   @default("OPEN") @db.VarChar(20)
  totalCashSales        Decimal  @default(0) @map("total_cash_sales") @db.Decimal(12, 3)
  totalCardSales        Decimal  @default(0) @map("total_card_sales") @db.Decimal(12, 3)
  totalOtherSales       Decimal  @default(0) @map("total_other_sales") @db.Decimal(12, 3)
  totalDrops            Decimal  @default(0) @map("total_drops") @db.Decimal(12, 3)
  totalPettyCash        Decimal  @default(0) @map("total_petty_cash") @db.Decimal(12, 3)
  totalRefunds          Decimal  @default(0) @map("total_refunds") @db.Decimal(12, 3)
  ordersCount           Int      @default(0) @map("orders_count")
  managerApprovalId     String?  @map("manager_approval_id")
  closingNotes          String?  @map("closing_notes") @db.Text

  cashMovements       CashMovement[]
  denominationCounts  DenominationCount[]

  @@index([terminalId])
  @@index([userId])
  @@index([businessDate])
  @@index([status])
  @@map("register_sessions")
}

model CashMovement {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  movementType String   @map("movement_type") @db.VarChar(20)
  amount       Decimal  @db.Decimal(12, 3)
  reason       String   @db.VarChar(255)
  approvedBy   String?  @map("approved_by")
  movementTime DateTime @default(now()) @map("movement_time")

  session RegisterSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([movementType])
  @@map("cash_movements")
}

model DenominationCount {
  id           String  @id @default(uuid())
  sessionId    String  @map("session_id")
  denomination Decimal @db.Decimal(10, 2)
  count        Int
  total        Decimal @db.Decimal(12, 3)

  session RegisterSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("denomination_counts")
}

// ============================================================================
// MODULE 09: CUSTOMERS
// ============================================================================

model Customer {
  id              String   @id @default(uuid())
  code            String   @unique @db.VarChar(30)
  nameAr          String   @map("name_ar") @db.VarChar(255)
  nameEn          String   @map("name_en") @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  email           String?  @db.VarChar(255)
  loyaltyPoints   Int      @default(0) @map("loyalty_points")
  loyaltyTier     String   @default("BRONZE") @map("loyalty_tier") @db.VarChar(20)
  totalSpent      Decimal  @default(0) @map("total_spent") @db.Decimal(12, 3)
  visitsCount     Int      @default(0) @map("visits_count")
  lastVisit       DateTime? @map("last_visit")
  isActive        Boolean  @default(true) @map("is_active")
  customFields    Json?    @map("custom_fields")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@index([email])
  @@index([loyaltyTier])
  @@map("customers")
}

// ============================================================================
// MODULE 11: SETTINGS
// ============================================================================

model StoreSettings {
  id              String   @id @default(uuid())
  nameAr          String   @map("name_ar") @db.VarChar(255)
  nameEn          String   @map("name_en") @db.VarChar(255)
  taxNumber       String   @map("tax_number") @db.VarChar(50)
  taxRate         Decimal  @map("tax_rate") @db.Decimal(5, 4)
  serviceCharge   Decimal  @default(0) @map("service_charge") @db.Decimal(5, 4)
  currency        String   @default("SAR") @db.VarChar(3)
  timezone        String   @default("Asia/Riyadh") @db.VarChar(50)
  locale          String   @default("ar-SA") @db.VarChar(10)
  address         String?  @db.Text
  phone           String?  @db.VarChar(20)
  email           String?  @db.VarChar(255)
  logo            String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(50)
  password     String   @db.VarChar(255)
  pin          String?  @db.VarChar(10)
  nameAr       String   @map("name_ar") @db.VarChar(255)
  nameEn       String   @map("name_en") @db.VarChar(255)
  email        String?  @unique @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  roleId       String?  @map("role_id")
  role         String   @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRole     Role?    @relation(fields: [roleId], references: [id])
  authLogs     AuthenticationLog[]

  @@index([username])
  @@index([role])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(50)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  description String?  @db.Text
  level       Int      @default(5)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  nameAr      String   @map("name_ar") @db.VarChar(100)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  section     String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthenticationLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  method        String   @db.VarChar(20)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(50)
  userAgent     String?  @map("user_agent") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("authentication_logs")
}

// ============================================================================
// MODULE 06: KITCHEN
// ============================================================================

model KitchenStation {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  nameAr       String   @map("name_ar") @db.VarChar(100)
  color        String   @default("#3B82F6") @db.VarChar(7)
  displayOrder Int      @default(0) @map("display_order")
  categoryIds  String[] @map("category_ids")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets KitchenTicket[]

  @@index([displayOrder])
  @@map("kitchen_stations")
}

model KitchenTicket {
  id           String    @id @default(uuid())
  ticketNumber String    @unique @map("ticket_number") @db.VarChar(30)
  orderId      String    @map("order_id")
  stationId    String    @map("station_id")
  priority     Int       @default(0)
  status       String    @default("NEW") @db.VarChar(20)
  receivedAt   DateTime  @default(now()) @map("received_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  station KitchenStation      @relation(fields: [stationId], references: [id])
  items   KitchenTicketItem[]

  @@index([stationId])
  @@index([status])
  @@index([orderId])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id            String   @id @default(uuid())
  ticketId      String   @map("ticket_id")
  productId     String   @map("product_id")
  productName   String   @map("product_name") @db.VarChar(255)
  productNameAr String   @map("product_name_ar") @db.VarChar(255)
  quantity      Int
  notes         String?  @db.Text
  modifiers     Json?
  status        String   @default("NEW") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  ticket KitchenTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("kitchen_ticket_items")
}

// ============================================================================
// MODULE 12: TABLES
// ============================================================================

model Floor {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  nameAr       String   @map("name_ar") @db.VarChar(100)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tables Table[]

  @@index([displayOrder])
  @@map("floors")
}

model Table {
  id             String   @id @default(uuid())
  number         String   @db.VarChar(20)
  floorId        String   @map("floor_id")
  capacity       Int      @default(4)
  section        String   @default("INDOOR") @db.VarChar(20)
  shape          String   @default("SQUARE") @db.VarChar(20)
  positionX      Int?     @map("position_x")
  positionY      Int?     @map("position_y")
  status         String   @default("AVAILABLE") @db.VarChar(20)
  currentOrderId String?  @map("current_order_id")
  waiterId       String?  @map("waiter_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  floor        Floor              @relation(fields: [floorId], references: [id])
  reservations TableReservation[]

  @@unique([floorId, number])
  @@index([floorId])
  @@index([status])
  @@map("tables")
}

model TableReservation {
  id              String    @id @default(uuid())
  tableId         String    @map("table_id")
  customerId      String?   @map("customer_id")
  customerName    String    @map("customer_name") @db.VarChar(255)
  customerPhone   String    @map("customer_phone") @db.VarChar(20)
  reservedFor     DateTime  @map("reserved_for")
  partySize       Int       @map("party_size")
  duration        Int       @default(120)
  specialRequests String?   @map("special_requests") @db.Text
  status          String    @default("PENDING") @db.VarChar(20)
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  table Table @relation(fields: [tableId], references: [id])

  @@index([tableId])
  @@index([reservedFor])
  @@index([status])
  @@map("table_reservations")
}

// ============================================================================
// MODULE 13: DISCOUNTS
// ============================================================================

model Discount {
  id                  String    @id @default(uuid())
  code                String    @unique @db.VarChar(50)
  name                String    @db.VarChar(100)
  nameAr              String    @map("name_ar") @db.VarChar(100)
  description         String?   @db.Text
  type                String    @db.VarChar(20)
  value               Decimal   @db.Decimal(12, 3)
  minOrderAmount      Decimal?  @map("min_order_amount") @db.Decimal(12, 3)
  maxDiscount         Decimal?  @map("max_discount") @db.Decimal(12, 3)
  applicableOn        String    @default("ORDER") @map("applicable_on") @db.VarChar(20)
  categoryIds         String[]  @map("category_ids")
  productIds          String[]  @map("product_ids")
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  startTime           String?   @map("start_time") @db.VarChar(5)
  endTime             String?   @map("end_time") @db.VarChar(5)
  daysOfWeek          Int[]     @map("days_of_week")
  isCorporate         Boolean   @default(false) @map("is_corporate")
  corporateIds        String[]  @map("corporate_ids")
  requiresApproval    Boolean   @default(false) @map("requires_approval")
  approvalThreshold   Decimal?  @map("approval_threshold") @db.Decimal(12, 3)
  maxUses             Int?      @map("max_uses")
  usedCount           Int       @default(0) @map("used_count")
  maxUsesPerCustomer  Int?      @map("max_uses_per_customer")
  isActive            Boolean   @default(true) @map("is_active")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  usages DiscountUsage[]

  @@index([code])
  @@index([isActive])
  @@map("discounts")
}

model DiscountUsage {
  id             String    @id @default(uuid())
  discountId     String    @map("discount_id")
  orderId        String    @map("order_id")
  customerId     String?   @map("customer_id")
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 3)
  orderTotal     Decimal   @map("order_total") @db.Decimal(12, 3)
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  appliedBy      String    @map("applied_by")
  appliedAt      DateTime  @default(now()) @map("applied_at")

  discount Discount @relation(fields: [discountId], references: [id])

  @@index([discountId])
  @@index([orderId])
  @@map("discount_usages")
}

// ============================================================================
// MODULE 15: DELIVERY
// ============================================================================

model DeliveryZone {
  id                    String   @id @default(uuid())
  name                  String   @db.VarChar(100)
  nameAr                String   @map("name_ar") @db.VarChar(100)
  districts             String[]
  deliveryFee           Decimal  @map("delivery_fee") @db.Decimal(12, 3)
  minOrderAmount        Decimal? @map("min_order_amount") @db.Decimal(12, 3)
  freeDeliveryThreshold Decimal? @map("free_delivery_threshold") @db.Decimal(12, 3)
  estimatedTime         Int      @map("estimated_time")
  coordinates           Json?
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@map("delivery_zones")
}

model Driver {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  licenseNumber      String    @unique @map("license_number") @db.VarChar(50)
  vehicleType        String    @map("vehicle_type") @db.VarChar(20)
  vehiclePlate       String    @map("vehicle_plate") @db.VarChar(20)
  phone              String    @db.VarChar(20)
  status             String    @default("OFFLINE") @db.VarChar(20)
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  lastLocationUpdate DateTime? @map("last_location_update")
  totalDeliveries    Int       @default(0) @map("total_deliveries")
  rating             Decimal?  @db.Decimal(3, 2)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@index([status])
  @@map("drivers")
}

model Delivery {
  id               String    @id @default(uuid())
  orderId          String    @unique @map("order_id")
  addressId        String    @map("address_id")
  zoneId           String?   @map("zone_id")
  driverId         String?   @map("driver_id")
  deliveryFee      Decimal   @map("delivery_fee") @db.Decimal(12, 3)
  scheduledFor     DateTime? @map("scheduled_for")
  pickedUpAt       DateTime? @map("picked_up_at")
  deliveredAt      DateTime? @map("delivered_at")
  status           String    @default("PENDING") @db.VarChar(20)
  estimatedTime    Int?      @map("estimated_time")
  trackingNotes    String?   @map("tracking_notes") @db.Text
  customerRating   Int?      @map("customer_rating")
  customerFeedback String?   @map("customer_feedback") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  zone   DeliveryZone? @relation(fields: [zoneId], references: [id])
  driver Driver?       @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId])
  @@map("deliveries")
}

// ============================================================================
// MODULE 10: COMPLIANCE
// ============================================================================

model ComplianceInvoice {
  id              String   @id @default(uuid())
  orderId         String   @unique @map("order_id")
  invoiceNumber   String   @unique @map("invoice_number") @db.VarChar(50)
  invoiceHash     String   @map("invoice_hash") @db.VarChar(255)
  previousHash    String?  @map("previous_hash") @db.VarChar(255)
  qrCode          String   @map("qr_code") @db.Text
  signedXml       String?  @map("signed_xml") @db.Text
  submissionStatus String  @default("PENDING") @map("submission_status") @db.VarChar(20)
  submittedAt     DateTime? @map("submitted_at")
  responseCode    String?  @map("response_code") @db.VarChar(20)
  responseMessage String?  @map("response_message") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([submissionStatus])
  @@map("compliance_invoices")
}

// ============================================================================
