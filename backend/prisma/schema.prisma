model TaxSetting {
  id               String   @id @default(uuid())
  name             String   @db.VarChar(100)
  nameAr           String   @map("name_ar") @db.VarChar(100)
  rate             Decimal  @db.Decimal(5, 2)
  isDefault        Boolean  @default(false) @map("is_default")
  applyToProducts  Boolean  @default(true) @map("apply_to_products")
  applyToServices  Boolean  @default(true) @map("apply_to_services")
  exemptCategories String[] @map("exempt_categories")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")

  @@index([isDefault])
  @@map("tax_settings")
}

model POSTerminal {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(100)
  nameAr           String    @map("name_ar") @db.VarChar(100)
  code             String    @unique @db.VarChar(20)
  ipAddress        String?   @map("ip_address") @db.VarChar(50)
  macAddress       String?   @map("mac_address") @db.VarChar(50)
  receiptPrinter   Json?     @map("receipt_printer")
  kitchenPrinter   Json?     @map("kitchen_printer")
  labelPrinter     Json?     @map("label_printer")
  cashDrawerPort   String?   @map("cash_drawer_port") @db.VarChar(20)
  customerDisplay  Json?     @map("customer_display")
  autoOpenDrawer   Boolean   @default(true) @map("auto_open_drawer")
  printReceipt     Boolean   @default(true) @map("print_receipt")
  printKitchen     Boolean   @default(true) @map("print_kitchen")
  currentSessionId String?   @map("current_session_id")
  isActive         Boolean   @default(true) @map("is_active")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
