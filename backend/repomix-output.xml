      const result = await service.getInventoryValuation();

      expect(result.totalValue).toBe(2000); // 100*10 + 50*20
      expect(result.itemCount).toBe(2);
      expect(result.items).toHaveLength(2);
    });

    it('should handle empty inventory', async () => {
