        deletedAt: new Date(),
        deletedBy: 'user-1',
      },
    });

    // Verify soft delete
    const deletedOrder = await prisma.salesOrder.findUnique({
      where: { id: order.id },
    });

    expect(deletedOrder?.deletedAt).toBeDefined();
    expect(deletedOrder?.deletedBy).toBe('user-1');
