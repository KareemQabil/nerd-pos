describe('SalesService', () => {
  let service: SalesService;
  let repo: ReturnType<typeof createMockRepository>;
  let eventBus: ReturnType<typeof createMockEventBus>;
  let prisma: ReturnType<typeof createMockPrismaService>;

  beforeEach(async () => {
