model Address {
  id         String   @id @default(uuid())
  street     String   @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  country    String   @default("SA") @db.VarChar(50)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  building   String?  @db.VarChar(100)
  floor      String?  @db.VarChar(20)
  apartment  String?  @db.VarChar(50)
  landmark   String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@map("addresses")
}

model DeliveryZone {
  id                    String   @id @default(uuid())
  name                  String   @db.VarChar(100)
  nameAr                String   @map("name_ar") @db.VarChar(100)
  districts             String[]
  deliveryFee           Decimal  @map("delivery_fee") @db.Decimal(12, 3)
  minOrderAmount        Decimal? @map("min_order_amount") @db.Decimal(12, 3)
  freeDeliveryThreshold Decimal? @map("free_delivery_threshold") @db.Decimal(12, 3)
  estimatedTime         Int      @map("estimated_time")
  coordinates           Json?
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@map("delivery_zones")
}

model Driver {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  licenseNumber      String    @unique @map("license_number") @db.VarChar(50)
  vehicleType        String    @map("vehicle_type") @db.VarChar(20)
  vehiclePlate       String    @map("vehicle_plate") @db.VarChar(20)
  phone              String    @db.VarChar(20)
  status             String    @default("OFFLINE") @db.VarChar(20)
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  lastLocationUpdate DateTime? @map("last_location_update")
  totalDeliveries    Int       @default(0) @map("total_deliveries")
  rating             Decimal?  @db.Decimal(3, 2)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@index([status])
  @@map("drivers")
}

model Delivery {
  id               String    @id @default(uuid())
  orderId          String    @unique @map("order_id")
  addressId        String    @map("address_id")
  zoneId           String?   @map("zone_id")
  driverId         String?   @map("driver_id")
  deliveryFee      Decimal   @map("delivery_fee") @db.Decimal(12, 3)
  scheduledFor     DateTime? @map("scheduled_for")
  pickedUpAt       DateTime? @map("picked_up_at")
  deliveredAt      DateTime? @map("delivered_at")
  status           String    @default("PENDING") @db.VarChar(20)
  estimatedTime    Int?      @map("estimated_time")
  trackingNotes    String?   @map("tracking_notes") @db.Text
  customerRating   Int?      @map("customer_rating")
  customerFeedback String?   @map("customer_feedback") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  address Address        @relation(fields: [addressId], references: [id])
  zone    DeliveryZone?  @relation(fields: [zoneId], references: [id])
  driver  Driver?        @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId])
  @@index([addressId])
  @@map("deliveries")
}

