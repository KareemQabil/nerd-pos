  @Put('store')
  @Permissions(PERMISSIONS.SETTINGS_UPDATE) // 🔒 Admin only
  @ApiOperation({
    summary: 'Update store settings',
    description: 'Updates store configuration. Admin only.',
  })
  @ApiResponse({
    status: 200,
    description: 'Store settings updated',
    schema: {
      example: {
        success: true,
        message: 'Store settings updated',
        data: {
