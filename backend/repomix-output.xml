  log(`    - 1x Iced Latte @ 18.00 SAR`, 'info');
  log(`    - 1x Cheese Cake @ 25.00 SAR`, 'info');
  log(`  • Subtotal: 78.00 SAR`, 'info');
  log(`  • Tax (15%): 11.70 SAR`, 'info');
  log(`  • Total: 89.70 SAR ✓`, 'success');
