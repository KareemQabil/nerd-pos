        {
          reason: 'Concurrent refund 2',
          items: [{ orderItemId: 'item-1', quantity: 1 }],
        },
        'user-2',
      )
      .catch((e: any) => ({ error: e }));

    const [result1, result2] = await Promise.all([refund1, refund2]);

    const hasError = 'error' in result1 || 'error' in result2;
    expect(hasError).toBe(true);
  });
});
