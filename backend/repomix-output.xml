  @ApiOperation({
    summary: 'Get store settings',
    description: 'Returns store configuration. Manager+ required.',
  })
  @ApiResponse({
    status: 200,
    description: 'Store settings retrieved',
    schema: {
      example: {
        success: true,
        message: 'Request successful',
        data: {
          id: 'store_1',
          name: 'NerdBased Coffee',
          vatNumber: '300000000000003',
          address: 'Riyadh, KSA',
          currency: 'SAR',
