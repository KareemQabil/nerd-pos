  recordResult('Subtotal (100)', '100', o1.itemSubtotal || o1.subtotal);
  recordResult('Tax (15%)', '15', o1.taxAmount || o1.tax);
  recordResult('Total', '115', o1.grandTotal || o1.total);
  
  // Test case: Decimal price
