    const orderPrefix = `ORD${now.getFullYear()}${(now.getMonth() + 1).toString().padStart(2, '0')}`;
    await (prisma as any).orderItem
      .deleteMany({
        where: { order: { orderNumber: { startsWith: orderPrefix } } },
      })
      .catch(() => {});
    await (prisma as any).salesOrder
      .deleteMany({
