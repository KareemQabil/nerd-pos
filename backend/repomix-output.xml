    it('should publish OrderConfirmed event', async () => {
      const draftOrder = { id: 'order-1', status: 'DRAFT', items: [] };
      repo.findById.mockResolvedValue(draftOrder);
      repo.update.mockResolvedValue({ ...draftOrder, status: 'CONFIRMED' });

