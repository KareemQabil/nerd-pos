  // ✅ Grand Total = Discounted Subtotal + Tax
  ctx.grandTotal = (ctx.discountedSubtotal || ctx.subtotalBeforeTax)
    .plus(ctx.taxAmount)
    .toDecimalPlaces(2);
    
  if (ctx.grandTotal.lessThan(0)) {
    ctx.grandTotal = new Decimal(0);
  }
  return ctx;
}
