    await app.init();
    prisma = app.get(PrismaService);
    jwtService = app.get(JwtService);

    for (const code of paymentPermissions) {
      const existing = await prisma.permission.findUnique({ where: { code } });
      if (existing) {
        continue;
      }
      const created = await prisma.permission.create({
        data: {
          code,
          name: code,
          nameAr: code,
          module: code.split('.')[0],
          section: null,
        },
      });
