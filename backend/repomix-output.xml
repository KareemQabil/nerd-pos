        sku: 'PRICE-TEST',
        price: originalPrice,
        isActive: true,
      },
    });

    // Update price
    await prisma.product.update({
      where: { id: product.id },
      data: {
        price: newPrice,
        updatedAt: new Date(),
      },
    });

    // Verify price changed
    const updatedProduct = await prisma.product.findUnique({
      where: { id: product.id },
    });

    expect(updatedProduct?.price.toNumber()).toBe(newPrice);
    expect(updatedProduct?.updatedAt).toBeDefined();
  });
});
