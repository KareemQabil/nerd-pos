      expect(result.totalValue).toBe(0);
      expect(result.itemCount).toBe(0);
      expect(result.items).toHaveLength(0);
    });

    it('should handle null quantity or cost', async () => {
      prisma.inventoryItem.findMany.mockResolvedValue([
