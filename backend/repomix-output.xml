  log(`  • Customer: ${TEST_DATA.customer.nameEn}`, 'info');
  log(`  • Items: 2x Burger + 2x Latte`, 'info');
  log(`  • Zone: ${TEST_DATA.deliveryZone.name}`, 'info');
  log(`  • Payment: VISA ✓`, 'success');
}

