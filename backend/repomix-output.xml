      expect(repo.createBatch).toHaveBeenCalled();
      expect(repo.createMovement).toHaveBeenCalledWith(
        expect.objectContaining({ type: 'IN' }),
      );
      expect(eventBus.publish).toHaveBeenCalledWith(
