      expect(repo.createWithItems).toHaveBeenCalled();
      expect(eventBus.publish).toHaveBeenCalledWith(
        'OrderCreated',
        expect.anything(),
      );
    });

    it('should generate unique order number via createOrder', async () => {
      const dto = {
        type: 'TAKEAWAY' as const,
        items: [
          {
            productId: 'prod-1',
            name: 'Test',
            nameAr: 'اختبار',
            price: 10.0,
