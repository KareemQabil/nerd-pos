// ==================== CREATE PAYMENT ====================
export class CreatePaymentDto {
  @IsUUID()
  orderId: string;
  @IsEnum(['CASH', 'CARD', 'MADA', 'WALLET'])
  method: 'CASH' | 'CARD' | 'MADA' | 'WALLET';
  @IsNumber()
  amount: number;
  @IsOptional()
  @IsNumber()
  receivedAmount?: number; // For cash
  @IsOptional()
  @IsString()
  cardLast4?: string;
  @IsOptional()
  @IsString()
  cardType?: string;
  @IsOptional()
  @IsString()
  transactionId?: string;
  @IsOptional()
  @IsNumber()
  tipAmount?: number;
  @IsString()
