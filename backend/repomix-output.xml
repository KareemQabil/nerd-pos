  subHeader('4.2 Create Dine-In Order');
  
  /*
   * Scenario: Customer at Table T1 orders:
   * - 1 Burger @ 35 SAR
   * - 1 Iced Latte @ 18 SAR
   * - 1 Cheese Cake @ 25 SAR
   * 
   * Subtotal: 35 + 18 + 25 = 78 SAR
